<Window x:Class="BimGo.Forms.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BimGo — Options"
        Width="760" Height="720" MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F8"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1B1F24"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0E7490"/>
        <SolidColorBrush x:Key="Muted" Color="#4B5560"/>
        <SolidColorBrush x:Key="CardBorder" Color="#DADDE1"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="MonoBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#B7BDC4"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B7BDC4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ButtonCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" Click="ButtonCancel_Click"/>
                    <Button x:Name="ButtonLaunch" Content="Launch BimGo" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ButtonLaunch_Click"/>
                </StackPanel>
                <TextBlock x:Name="TextEstimate" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="About 0 elements"/>
            </DockPanel>
        </Border>

        <!-- Start position (always visible) -->
        <Border DockPanel.Dock="Top" Background="#E6F4F7" BorderBrush="#A8D8E2" BorderThickness="1" Padding="12,10" Margin="24,16,24,10">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Start position: "/>
                <Run x:Name="RunSpawn" Text="—"/>
            </TextBlock>
        </Border>

        <!-- The options, one tab per area (the last tab used is remembered) -->
        <TabControl x:Name="Tabs" Margin="24,0,24,12" Background="White" BorderBrush="{StaticResource CardBorder}">
            <TabItem Header="Load">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Active view only -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="WHAT TO LOAD"/>
                        <CheckBox x:Name="CheckViewOnly" FontWeight="SemiBold" Content="Only elements visible in the active view" Click="CheckViewOnly_Click"/>
                        <TextBlock x:Name="TextViewOnly" Margin="22,4,0,16" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="—"/>

                        <!-- Phases -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="PHASES (DEMOLITION HAPPENS BETWEEN THESE)"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Existing phase"/>
                            <ComboBox x:Name="ComboExistingPhase" Grid.Row="0" Grid.Column="1" Width="260" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="New phase"/>
                            <ComboBox x:Name="ComboNewPhase" Grid.Row="1" Grid.Column="1" Width="260" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                            <TextBlock x:Name="TextPhaseHint" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="The walkthrough shows the model as it stands in the new phase. The Demolish gun demolishes existing elements in the new phase; new work can only be deleted. Clones are created in the new phase."/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Categories">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Categories -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="CATEGORIES TO LOAD"/>
                        <UniformGrid x:Name="GridGroups" Columns="3" Margin="-5,0,-5,0"/>
                        <CheckBox x:Name="CheckHeavy" Margin="0,10,0,18" Content="Include ducts, pipes, cable trays and conduits (heavy)" Checked="AnyCategory_Changed" Unchecked="AnyCategory_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Geometry">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Geometry -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="GEOMETRY"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Triangle limit per element"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TextThreshold" Style="{StaticResource MonoBox}"/>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="Applies to FFE and services, not walls, floors or structure"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Over the limit"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="RadioProxy" GroupName="OverLimit" Content="Bounding-box proxy" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RadioSkip" GroupName="OverLimit" Content="Skip"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Max step height (stairs)"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TextStep" Style="{StaticResource MonoBox}"/>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="mm"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,0,0" Text="Helper geometry"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                <CheckBox x:Name="CheckSkipHelpers" Content="Leave out light sources (IES cones) and any subcategory whose name contains:" Click="CheckSkipHelpers_Click"/>
                                <TextBox x:Name="TextHelperKeywords" Height="28" Margin="22,6,0,0" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#B7BDC4"
                                         ToolTip="Comma-separated, case-insensitive parts of subcategory names (e.g. clearance, zone, cone)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Materials">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Colour mode (moved from Geometry: Realistic depends on the extraction below) -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="COLOUR MODE AT LAUNCH"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="RadioWhitecard" GroupName="Colour" Content="Whitecard" Margin="0,0,16,0" Click="DisplayControl_Changed"/>
                            <RadioButton x:Name="RadioMaterial" GroupName="Colour" Content="Material colours" Margin="0,0,16,0" Click="DisplayControl_Changed"/>
                            <RadioButton x:Name="RadioRealistic" GroupName="Colour" Content="Realistic (textures)" Click="RadioRealistic_Click"
                                         ToolTip="Render colours and textures, as Revit's Realistic view. Needs materials and textures extracted (below)."/>
                        </StackPanel>
                        <TextBlock Margin="0,0,0,18" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Can be changed in the walkthrough (pause menu → Display). Realistic ticks the extraction below."/>

                        <!-- Materials and textures (opt-in: keeps light models light) -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="MATERIALS &amp; TEXTURES (REALISTIC COLOUR MODE)"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <CheckBox x:Name="CheckTextures" FontWeight="SemiBold" Content="Extract materials and textures" Click="CheckTextures_Click"/>
                                <TextBlock Margin="22,4,0,8" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Embeds each material's render colour and colour texture with its real-world size, for the Realistic colour mode. Takes longer and makes snapshots and .bimgo files bigger; leave it off for a light model."/>
                                <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Text="Max texture size"/>
                                    <ComboBox x:Name="ComboTextureSize" Width="110" Height="28" VerticalContentAlignment="Center"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" Text="longest side, px · larger is sharper but uses more GPU memory"/>
                                </StackPanel>
                                <TextBlock x:Name="TextTextureSources" Margin="22,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="—"/>
                                <CheckBox x:Name="CheckProxyTextures" Margin="22,10,0,0" Content="Proxy textures for missing images"
                                          ToolTip="Draws a CC0 stand-in texture (brick, timber, carpet…) chosen by material name when an image can't be found. Plain-colour materials are left alone."/>
                                <StackPanel Orientation="Horizontal" Margin="22,10,0,0">
                                    <Button x:Name="ButtonReviewTextures" Content="Review textures…" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0" Click="ButtonReviewTextures_Click"
                                            ToolTip="Lists the materials this Go will read, with missing images. Point at a folder to find them, or pick an image or a proxy per material."/>
                                    <TextBlock x:Name="TextTextureOverrides" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Links">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Linked models -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="LINKED MODELS (READ-ONLY IN THE WALKTHROUGH)"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <StackPanel x:Name="PanelLinks"/>
                                <TextBlock x:Name="TextLinkSummary" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Ticked links come in with the same categories, shown in their phase with the same name as the new phase (else their last phase). In the walkthrough their elements can be scanned, measured and commented on, but not demolished, moved or copied."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Parameters">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Extra parameters -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="EXTRA PARAMETERS (SHOWN BY THE SCAN GUN, SAVED IN .BIMGO FILES)"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="ButtonScanParameters" DockPanel.Dock="Right" Content="Scan model" Style="{StaticResource SecondaryButton}" Height="28" Click="ButtonScanParameters_Click"/>
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" Text="Filter"/>
                                    <TextBox x:Name="TextParameterFilter" Height="28" Margin="0,0,10,0" Padding="6,0" VerticalContentAlignment="Center" BorderBrush="#B7BDC4" TextChanged="TextParameterFilter_TextChanged"/>
                                </DockPanel>
                                <ListBox x:Name="ListParameters" Height="150" BorderBrush="{StaticResource CardBorder}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock x:Name="TextParameterSummary" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="None selected."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Player">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,16,20,16">
                        <!-- Player & display -->
                        <TextBlock Style="{StaticResource SectionHeader}" Text="QUALITY PROFILE"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox x:Name="ComboProfile" Width="160" Height="28" VerticalContentAlignment="Center" SelectionChanged="ComboProfile_SelectionChanged">
                                <ComboBoxItem Content="Custom"/>
                                <ComboBoxItem Content="Basic"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Realistic"/>
                            </ComboBox>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="Same profiles as the pause menu"/>
                        </StackPanel>
                        <TextBlock x:Name="TextProfile" Margin="0,4,0,18" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="—"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="PLAYER &amp; DISPLAY"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Anti-aliasing"/>
                            <ComboBox x:Name="ComboMsaa" Grid.Row="0" Grid.Column="1" Width="140" Height="28" HorizontalAlignment="Left" VerticalContentAlignment="Center" SelectionChanged="DisplayCombo_Changed">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="MSAA 2x"/>
                                <ComboBoxItem Content="MSAA 4x"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Field of view"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="SliderFov" Width="200" Minimum="60" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TextFov" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" Text="90°"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Mouse sensitivity"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="SliderSensitivity" Width="200" Minimum="0.1" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                                <TextBlock x:Name="TextSensitivity" Margin="10,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" Text="1.00"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Options"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="CheckInvertY" Content="Invert Y" Margin="0,0,16,0"/>
                                <CheckBox x:Name="CheckVSync" Content="VSync" Margin="0,0,16,0"/>
                                <CheckBox x:Name="CheckComments" Content="Load comments"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Gizmo snap"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="CheckSnap" Content="Snap moves and rotations" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox x:Name="ComboSnapMove" Width="90" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Move increment"/>
                                <ComboBox x:Name="ComboSnapAngle" Width="70" Height="28" VerticalContentAlignment="Center" ToolTip="Rotation increment"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="G turns snap on/off in the walkthrough"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Shadow quality"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="ComboShadowQuality" Width="140" Height="28" VerticalContentAlignment="Center" SelectionChanged="DisplayCombo_Changed">
                                    <ComboBoxItem Content="Low"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="High"/>
                                </ComboBox>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="O toggles shadows · Shift+O opens the sun panel"/>
                            </StackPanel>

                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Artificial lights"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="ComboArtificialLights" Width="140" Height="28" VerticalContentAlignment="Center" SelectionChanged="DisplayCombo_Changed">
                                    <ComboBoxItem Content="Off"/>
                                    <ComboBoxItem Content="Glow only"/>
                                    <ComboBoxItem Content="Glow + light"/>
                                </ComboBox>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Text="Lighting fixtures glow and cast light · K cycles"/>
                            </StackPanel>
                        </Grid>

                        <!-- Where a live session keeps comments, bookmarks, sun and hidden elements -->
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,18,0,8" Text="COMMENTS, BOOKMARKS AND VIEW STATE"/>
                        <CheckBox x:Name="CheckSidecarsBesideModel" Content="Also write them beside the model when its folder is writable"/>
                        <TextBlock x:Name="TextSidecars" Margin="22,4,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="They are always kept in BimGo's own folder for this model (%LocalAppData%\BimGo\Models). Tick this to share them with colleagues on a shared drive: newer copies there are read at each Go. Cloud models can't share this way; use .bimgo files."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
