<Project Sdk="Microsoft.NET.Sdk">

	<!--
		BimGo.App: the standalone walkthrough app (BimGo.exe) and the engine (GL renderer, physics, guns, HUD).
		No Revit references. Until live sessions arrive (phase 2) the Revit add-in also hosts this engine in-process
		through GameHost, which is why this exe is referenced by BimGo.Revit.

		UseWindowsForms only brings in-box framework pieces (System.Drawing for the font atlas, file dialogs).

		NuGet packages (see the README dependency table; every package needs Gavin's explicit yes):
		  Silk.NET.OpenGL: GL function bindings behind the Native/Gl.cs facade. Context creation stays in Native/Wgl.cs.
		The Revit add-in does not reference this project, so nothing here loads inside Revit.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>disable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>BimGo</RootNamespace>
		<AssemblyName>BimGo</AssemblyName>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<Version>1.0.0</Version>
		<Company>Author</Company>
		<Product>BimGo</Product>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Configurations>Debug;Release</Configurations>
		<StartupObject>BimGo.Program</StartupObject>
		<!-- The ">>" icon: embedded in BimGo.exe (Explorer, taskbar pins) and copied beside it for the window class -->
		<ApplicationIcon>Resources\BimGo.ico</ApplicationIcon>
		<!-- Shared install location used by every Revit year's add-in to find BimGo.exe -->
		<BimGoInstallDir>$(LocalAppData)\Programs\BimGo\</BimGoInstallDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BimGo.Core\BimGo.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Pinned. MIT. Pulls in Silk.NET.Core and Silk.NET.Maths (MIT). Do not add Silk.NET.Windowing / Input. -->
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\BimGo.ico" Link="BimGo.ico" CopyToOutputDirectory="PreserveNewest" />
		<!-- Licence texts travel with BimGo.exe (MIT obliges the third-party notices to ship with the binaries) -->
		<None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
		<!-- CC0 proxy textures (Realistic mode stand-ins for missing images): copied beside the exe as Resources\Proxies -->
		<None Update="Resources\Proxies\*.jpg;Resources\Proxies\*.png;Resources\Proxies\proxies.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
		Install a copy of the build to %LocalAppData%\Programs\BimGo\ so the add-ins (all Revit years) can launch it.
		Skipped quietly if BimGo.exe is running (the copy is retried on the next build).
	-->
	<Target Name="InstallBimGoApp" AfterTargets="Build" Condition="'$(BimGoInstallDir)' != ''">
		<ItemGroup>
			<BimGoAppFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
		</ItemGroup>
		<MakeDir Directories="$(BimGoInstallDir)" ContinueOnError="true" />
		<Copy SourceFiles="@(BimGoAppFiles)" DestinationFiles="@(BimGoAppFiles->'$(BimGoInstallDir)%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>

</Project>
